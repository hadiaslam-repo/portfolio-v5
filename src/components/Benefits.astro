.benefits_card.is-speed-card {
  grid-column: 3;
  grid-row: 1;
}

.benefits_card.is-cms {
  grid-column: 1;
  grid-row: 1;
  visibility: hidden;
  opacity: 0;
  pointer-events: none;
}

.benefits_card.is-component-setup {
  grid-column: 1;
  grid-row: 1;
}

.benefits-tabs {
  z-index: 5;
  position: absolute;
  top: 0;
  left: 50%;
  display: flex;
  padding: .25rem;
  border-radius: .75rem;
  background: var(--color-canvas);
  transform: translate(-50%, -50%);
  pointer-events: auto;
}

.benefits_card.is-component-setup .benefits_graphic_wrap,
.benefits_card.is-cms .benefits_graphic_wrap {
  overflow: visible;
}

.benefits-tabs__indicator {
  position: absolute;
  z-index: 0;
  top: .25rem;
  bottom: .25rem;
  left: 0;
  border-radius: .5rem;
  background: var(--color-surface);
  pointer-events: none;
}

.benefits-tabs__item {
  position: relative;
  z-index: 1;
  padding: .5rem;
  border: 0;
  background: transparent;
  color: var(--color-text);
  font: inherit;
  font-size: var(--type-small);
  line-height: var(--leading-tight);
  cursor: pointer;
}

.benefits-tabs__item[aria-selected="true"] {
  color: var(--color-ink);
}

.benefits-tabs__item:focus-visible {
  outline: 2px solid var(--color-text);
  outline-offset: 2px;
}

.benefits_graphic_slug-icon { flex: none; width: .75rem; }
.benefits_graphic_output-wrap { gap: inherit; flex: 1; display: flex; min-height: 0; }

.benefits_card.is-cms .benefits_graphic_navigator-layer,
.benefits_card.is-cms .benefits_graphic_navigator-text {
  color: #c4afff;
}

.benefits_card.is-cms .benefits_graphic_navigator-text.is-neutral {
  color: var(--_colors---text--heading);
}

.benefits_card.is-cms [fill="#79E09C"],
.benefits_card.is-cms [fill="#79e09c"] {
  fill: #c4afff;
}

.benefits_card.is-cms .benefits_graphic_top-control {
  background-color: #c4afff;
}

.benefits_card.is-cms .div-block-2,
.benefits_card.is-cms .benefits_graphic_card-image-wrap,
.benefits_card.is-cms .benefits-graphic_input-output-wrap {
  border-color: #c4afff;
}

.benefits_graphic_slug-icon {
  flex: none;
}

.w-embed::before,
.w-embed::after {
  content: " ";
  display: table;
  grid-column: 1 / 2;
  grid-row: 1 / 2;
}

.w-embed::after {
  clear: both;
}

.benefits_graphic_navigator-layer.is-terminal
  > .benefits_graphic_navigator-arrow {
  opacity: 0;
}

.benefits_graphic_navigator-inner,
.benefits_graphic_navigator-layer-wrap { column-gap: .5rem; row-gap: .5rem; }
.benefits_graphic_navigator-layer { column-gap: .25rem; row-gap: .25rem; }
.benefits_graphic_navigator-icon { flex: none; width: 1rem; height: 1rem; }
.benefits_graphic_navigator-icon svg { display: block; width: 100%; height: 100%; }
.benefits_graphic_navigator-text { font-size: var(--type-small); line-height: var(--leading-tight); }
.text-size-tiny { font-size: var(--type-caption); }
.text-size-xtiny { font-size: .625rem; }
.line-height-100 { line-height: 1; }
.text-color-heading { color: var(--_colors---text--heading); }
.benefits_graphic_wrap,
.benefits_graphic_wrap .benefits_graphic_navigator-text,
.benefits_graphic_wrap .text-size-tiny,
.benefits_graphic_wrap .text-size-xtiny,
.benefits_graphic_wrap .contol-text { line-height: 1 !important; }
@media(max-width:991px){.benefits-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.benefits_card.is-speed-card{grid-column:1;grid-row:2}}@media(max-width:767px){.benefits-grid{grid-template-columns:1fr}.benefits_card{max-width:30rem}.benefits-switcher{grid-column:1;grid-row:auto}.benefits_card.is-speed-card{grid-column:1;grid-row:auto}}@media(max-width:479px){.benefits_card{gap:2rem;padding-top:1rem;padding-left:1rem}.benefit-copy{padding-right:1rem}}
</style>
<script>
  import gsap from 'gsap';

  const BASE_GRAPHIC_WIDTH = 408;

  function initializeBenefitGraphic(wrap: HTMLElement) {
    const inner = wrap.querySelector<HTMLElement>('.benefits_graphic_inner');
    if (!inner) return;

    function resizeGraphic() {
      const wrapperWidth = wrap.clientWidth;
      if (!wrapperWidth) return;

      const scale = wrapperWidth / BASE_GRAPHIC_WIDTH;
      inner.style.transform = 'none';
      inner.style.zoom = String(scale);
    }

    resizeGraphic();
    const observer = new ResizeObserver(resizeGraphic);
    observer.observe(wrap);
  }

  document
    .querySelectorAll<HTMLElement>('.benefits_graphic_wrap')
    .forEach(initializeBenefitGraphic);

  const tabs = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-benefits-tab]'),
  );
  const tabList = document.querySelector<HTMLElement>('.benefits-tabs');
  const indicator = document.querySelector<HTMLElement>('.benefits-tabs__indicator');
  const componentPanel = document.querySelector<HTMLElement>('.is-component-setup');
  const cmsPanel = document.querySelector<HTMLElement>('.benefits_card.is-cms');
  const panels = { component: componentPanel, cms: cmsPanel };
  let activeTab: 'component' | 'cms' = 'component';
  let isSwitching = false;

  function getPanelGroups(panel: HTMLElement) {
    return [
      panel.querySelector('.benefit-copy h2'),
      panel.querySelector('.benefit-copy p'),
      panel.querySelector('.graphic_structure_top'),
      panel.querySelector('.benefits_graphic_prop-panel'),
      ...panel.querySelectorAll('.benefits_graphic_output-wrap > *'),
    ].filter((element): element is Element => element instanceof Element);
  }

  function moveTabIndicator(tab: HTMLButtonElement, animate = true) {
    if (!tabList || !indicator) return;
    const x = tab.offsetLeft;
    const width = tab.offsetWidth;
    const options = { x, width, duration: .35, ease: 'power3.out' };
    animate ? gsap.to(indicator, options) : gsap.set(indicator, { x, width });
  }

  function selectBenefitsTab(next: 'component' | 'cms', focus = false) {
    if (next === activeTab || isSwitching) return;
    const outgoing = panels[activeTab];
    const incoming = panels[next];
    const nextButton = tabs.find((tab) => tab.dataset.benefitsTab === next);
    if (!outgoing || !incoming || !nextButton) return;

    isSwitching = true;
    const direction = next === 'cms' ? 1 : -1;
    const outgoingGroups = getPanelGroups(outgoing);
    const incomingGroups = getPanelGroups(incoming);

    tabs.forEach((tab) => {
      const selected = tab === nextButton;
      tab.setAttribute('aria-selected', String(selected));
      tab.tabIndex = selected ? 0 : -1;
    });
    moveTabIndicator(nextButton);
    if (focus) nextButton.focus();

    const timeline = gsap.timeline({
      defaults: { ease: 'power3.inOut' },
      onComplete: () => {
        activeTab = next;
        isSwitching = false;
      },
    });

    timeline
      .to(outgoingGroups, {
        x: -24 * direction,
        opacity: 0,
        duration: .32,
        stagger: .06,
      })
      .set(outgoing, { autoAlpha: 0, pointerEvents: 'none' })
      .add(() => outgoing.setAttribute('aria-hidden', 'true'))
      .set(incomingGroups, { x: 24 * direction, opacity: 0 })
      .set(incoming, { autoAlpha: 1, pointerEvents: 'auto' })
      .add(() => incoming.setAttribute('aria-hidden', 'false'))
      .to(incomingGroups, {
        x: 0,
        opacity: 1,
        duration: .42,
        stagger: .07,
      });
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      selectBenefitsTab(tab.dataset.benefitsTab as 'component' | 'cms');
    });
  });

  tabList?.addEventListener('keydown', (event) => {
    if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
    event.preventDefault();
    const next = activeTab === 'component' ? 'cms' : 'component';
    selectBenefitsTab(next, true);
  });

  const activeButton = tabs.find((tab) => tab.dataset.benefitsTab === activeTab);
  if (activeButton) requestAnimationFrame(() => moveTabIndicator(activeButton, false));
</script>
